<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">

    <Script file="HelpTip.lua"/>

    <!-- One-time help tip; instances set tipKey and textKey. The arrows sit
         at the right edge, so the tip opens leftward from its target.
         Arrow points down from below the tip; ArrowUp points up from above
         it and is shown instead when Lua's PlaceAt flips the tip below.
         ArrowUp sits left of CloseButton; ARROW_UP_OFFSET_X matches it. -->
    <Frame name="LDK_HelpTipTemplate" inherits="GlowBoxTemplate"
           mixin="LDK_HelpTipMixin"
           enableMouse="true" hidden="true" virtual="true" clampedToScreen="true">
        <Size x="220" y="60"/>
        <Scripts>
            <OnLoad method="OnLoad"/>
        </Scripts>
        <Layers>
            <Layer level="OVERLAY">
                <FontString parentKey="Text" inherits="GameFontHighlightLeft" justifyV="TOP">
                    <Size x="188" y="0"/>
                    <Anchors>
                        <Anchor point="TOPLEFT" x="16" y="-16"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Button parentKey="CloseButton" inherits="UIPanelCloseButton">
                <Anchors>
                    <Anchor point="TOPRIGHT" x="6" y="6"/>
                </Anchors>
            </Button>
            <Frame parentKey="Arrow" inherits="GlowBoxArrowTemplate">
                <Anchors>
                    <Anchor point="TOP" relativePoint="BOTTOM" y="4"/>
                    <Anchor point="RIGHT" x="-8"/>
                </Anchors>
            </Frame>
            <Frame parentKey="ArrowUp" hidden="true">
                <Size x="53" y="21"/>
                <Anchors>
                    <Anchor point="BOTTOM" relativePoint="TOP" y="-4"/>
                    <Anchor point="RIGHT" x="-40"/>
                </Anchors>
                <Layers>
                    <Layer level="ARTWORK">
                        <Texture parentKey="Arrow" inherits="HelpPlateArrowUp">
                            <Anchors>
                                <Anchor point="BOTTOMLEFT"/>
                            </Anchors>
                        </Texture>
                    </Layer>
                    <Layer level="BORDER">
                        <Texture parentKey="Glow" inherits="HelpPlateArrow-GlowUp" alphaMode="ADD" alpha="0.5">
                            <Anchors>
                                <Anchor point="BOTTOM"/>
                            </Anchors>
                        </Texture>
                    </Layer>
                </Layers>
            </Frame>
        </Frames>
    </Frame>

</Ui>
