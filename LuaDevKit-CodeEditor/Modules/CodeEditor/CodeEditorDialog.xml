<!--suppress ALL -->

<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">

    <Font name="LDK_CodeEditorFont" inherits="LDK_CodeEditorFont_UbuntuMono_14"/>
    <Script file="CodeEditBoxMixin.lua"/>
    <Script file="FAIAP.lua"/>
    <Script file="CodeEditorDialog.lua"/>

    <Frame name="LDK_CodeEditorDialogTemplate" virtual="true"
           mixin="LDK_CodeEditorDialogMixin"
           hidden="true" movable="true" resizable="true" enableMouse="true"
           frameStrata="DIALOG" clampedToScreen="true">

        <Size x="600" y="400"/>
        <Anchors>
            <Anchor point="CENTER" x="0" y="0"/>
        </Anchors>

        <Scripts>
            <OnLoad method="OnLoad"/>
        </Scripts>

        <Frames>
            <!-- Header row: full-width bar owning the title and the close button.
                 Drag-to-move lives here (it was on the old header Texture).
                 CloseFrame is declared before Title so Title's right edge can
                 anchor to it: fixed-width close + fluid title means the title
                 absorbs all remaining width. -->
            <Frame parentKey="Header" inherits="BackdropTemplate" enableMouse="true">
                <Size y="32"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="$parent" x="0" y="0"/>
                    <Anchor point="TOPRIGHT" relativeTo="$parent" x="0" y="0"/>
                </Anchors>
                <Frames>
                    <!-- No enableMouse: drags over its empty margin fall through
                         to Header; the Button still takes its own clicks. -->
                    <Frame parentKey="CloseFrame">
                        <Size x="32"/>
                        <Anchors>
                            <Anchor point="TOPRIGHT"/>
                            <Anchor point="BOTTOMRIGHT"/>
                        </Anchors>
                        <Frames>
                            <!-- OnClick is wired in Lua OnLoad, not here: the
                                 inherited UIPanelCloseButton_OnClick hides
                                 GetParent(), which at this depth is CloseFrame. -->
                            <Button parentKey="CloseButton" inherits="UIPanelCloseButton">
                                <Anchors>
                                    <Anchor point="CENTER"/>
                                </Anchors>
                            </Button>
                        </Frames>
                    </Frame>
                    <Frame parentKey="Title">
                        <Anchors>
                            <Anchor point="TOPLEFT"/>
                            <Anchor point="BOTTOMRIGHT" relativeKey="$parent.CloseFrame" relativePoint="BOTTOMLEFT"/>
                        </Anchors>
                        <Layers>
                            <Layer level="ARTWORK">
                                <FontString parentKey="Text" inherits="GameFontNormalSmall"
                                            justifyH="CENTER">
                                    <Anchors>
                                        <Anchor point="LEFT" x="4" y="0"/>
                                        <Anchor point="RIGHT" x="40" y="0"/>
                                    </Anchors>
                                </FontString>
                            </Layer>
                        </Layers>
                    </Frame>
                </Frames>
                <Scripts>
                    <OnMouseDown>
                        if button == "LeftButton" then
                        self:GetParent():StartMoving()
                        end
                    </OnMouseDown>
                    <OnMouseUp>
                        self:GetParent():StopMovingOrSizing()
                    </OnMouseUp>
                </Scripts>
            </Frame>

            <!-- Bottom-right resize grip, styled like AceGUI's Frame widget sizer_se -->
            <Frame parentKey="SizerSE" enableMouse="true">
                <Size x="25" y="25"/>
                <Anchors>
                    <Anchor point="BOTTOMRIGHT"/>
                </Anchors>
                <Layers>
                    <Layer level="BACKGROUND">
                        <!-- Diagonal tex-coords set in Lua OnLoad (SetTexCoord's 8-value quad form isn't expressible in XML) -->
                        <Texture parentKey="Line1" file="Interface\Tooltips\UI-Tooltip-Border">
                            <Size x="14" y="14"/>
                            <Anchors>
                                <Anchor point="BOTTOMRIGHT" x="-8" y="8"/>
                            </Anchors>
                        </Texture>
                        <Texture parentKey="Line2" file="Interface\Tooltips\UI-Tooltip-Border">
                            <Size x="8" y="8"/>
                            <Anchors>
                                <Anchor point="BOTTOMRIGHT" x="-8" y="8"/>
                            </Anchors>
                        </Texture>
                    </Layer>
                </Layers>
                <Scripts>
                    <OnMouseDown>
                        self:GetParent():StartSizing("BOTTOMRIGHT")
                    </OnMouseDown>
                    <OnMouseUp>
                        self:GetParent():StopMovingOrSizing()
                    </OnMouseUp>
                </Scripts>
            </Frame>

            <!-- Reserved space for future toolbar/controls (e.g. Accept/Run buttons) -->
            <Frame parentKey="TopBar" inherits="BackdropTemplate">
                <Size y="30"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.Header" relativePoint="BOTTOMLEFT"/>
                    <Anchor point="TOPRIGHT" relativeKey="$parent.Header" relativePoint="BOTTOMRIGHT"/>
                </Anchors>
                <Frames>
                    <!-- Absolute names (not $parent-relative): TopBar itself has no
                         name, only a parentKey, so $parent expansion would break here.

                         Both dropdowns below are hidden: only their menu machinery
                         (UIDropDownMenu_Initialize/ToggleDropDownMenu/UIDropDownMenu_SetText)
                         is used. The visible triggers are FontButton/FontSizeButton,
                         mirroring WowLua's icon-button pattern (a plain Button that opens
                         an otherwise-invisible UIDropDownMenuTemplate frame). -->
                    <Frame name="LDK_CodeEditorFontDropdown" parentKey="FontDropdown"
                           inherits="UIDropDownMenuTemplate" hidden="true">
                        <Anchors>
                            <Anchor point="RIGHT" x="-6" y="0"/>
                        </Anchors>
                    </Frame>
                    <Button name="LDK_CodeEditorFontButton" parentKey="FontButton">
                        <Size x="20" y="20"/>
                        <Anchors>
                            <Anchor point="RIGHT" relativeKey="$parent.FontDropdown" relativePoint="RIGHT" x="-4" y="0"/>
                        </Anchors>
                        <NormalTexture file="Interface\Icons\INV_Misc_Note_01"/>
                        <HighlightTexture file="Interface\Icons\INV_Misc_Note_01" alphaMode="ADD"/>
                    </Button>
                    <Frame name="LDK_CodeEditorFontSizeDropdown" parentKey="FontSizeDropdown"
                           inherits="UIDropDownMenuTemplate" hidden="true">
                        <Anchors>
                            <Anchor point="RIGHT" relativeKey="$parent.FontButton" relativePoint="LEFT" x="10" y="0"/>
                        </Anchors>
                    </Frame>
                    <Button name="LDK_CodeEditorFontSizeButton" parentKey="FontSizeButton">
                        <Size x="20" y="20"/>
                        <Anchors>
                            <Anchor point="RIGHT" relativeKey="$parent.FontButton" relativePoint="LEFT" x="-4" y="0"/>
                        </Anchors>
                        <NormalTexture file="Interface\Icons\INV_Misc_Gear_08"/>
                        <HighlightTexture file="Interface\Icons\INV_Misc_Gear_08" alphaMode="ADD"/>
                    </Button>
                </Frames>
            </Frame>

            <!-- Status/action bar -->
            <Frame parentKey="BottomBar" inherits="BackdropTemplate">
                <Size y="30"/>
                <Anchors>
                    <Anchor point="BOTTOMLEFT" relativeTo="$parent" x="0" y="16"/>
                    <Anchor point="BOTTOMRIGHT" relativeTo="$parent" x="0" y="16"/>
                </Anchors>
                <Frames>
                    <CheckButton parentKey="WrapCheckButton" inherits="UICheckButtonTemplate">
                        <Size x="24" y="24"/>
                        <Anchors>
                            <Anchor point="LEFT" x="14" y="0"/>
                        </Anchors>
                        <Scripts>
                            <OnClick>
                                self:GetParent():GetParent():OnWrapToggled(self:GetChecked())
                            </OnClick>
                        </Scripts>
                    </CheckButton>
                </Frames>
            </Frame>

            <!-- Hidden measuring string for wrap mode: same font and wrap settings as
                 CodeEditBox, width matched to its text area, so GetNumLines() reports
                 how many visual rows a given logical line will occupy. -->
            <Frame parentKey="WrapMeasure" hidden="true">
                <Size x="1" y="1"/>
                <Layers>
                    <Layer level="ARTWORK">
                        <FontString parentKey="Text" inherits="LDK_CodeEditorFont"
                                    justifyH="LEFT" justifyV="TOP" wordwrap="true">
                            <Anchors>
                                <Anchor point="TOPLEFT"/>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>

            <!-- Borders live on separate backing frames: a ScrollFrame clips at its
                 outer rect, but a backdrop edge is drawn *inside* that rect, so
                 content scrolled under the border band. Each ScrollFrame is inset
                 5px (BACKDROP_TOAST_12_12's own inset) inside its backing frame so
                 the clip edge lands just inside the border line. Gutter and code
                 share the same top inset so line rows stay aligned. -->
            <Frame parentKey="GutterBackdrop" inherits="BackdropTemplate">
                <Size x="34" y="1"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.TopBar" relativePoint="BOTTOMLEFT" x="16" y="0"/>
                    <Anchor point="BOTTOMLEFT" relativeKey="$parent.BottomBar" relativePoint="TOPLEFT" x="16" y="0"/>
                </Anchors>
            </Frame>

            <!-- Gutter: line-number column, a real ScrollFrame so its content clips like
                 the code area does; vertical scroll is driven in lockstep with it (see
                 OnCodeEditBoxScroll) rather than by direct user interaction. -->
            <ScrollFrame parentKey="Gutter">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.GutterBackdrop" relativePoint="TOPLEFT" x="5" y="-5"/>
                    <Anchor point="BOTTOMRIGHT" relativeKey="$parent.GutterBackdrop" relativePoint="BOTTOMRIGHT" x="-5" y="5"/>
                </Anchors>
                <ScrollChild>
                    <!-- Size is set from Lua (RefreshGutter): scroll children keep their
                         explicit size over right-side anchors, so a fixed width here
                         would not follow the Gutter's inset width. -->
                    <Frame parentKey="ScrollChild">
                        <Size x="1" y="1"/>
                        <Anchors>
                            <Anchor point="TOPLEFT"/>
                        </Anchors>
                        <Layers>
                            <Layer level="ARTWORK">
                                <!-- One FontString holding "1\n2\n...\nN" in the SAME font as
                                     CodeEditBox, so both columns get identical line pitch from
                                     the text engine: no per-line positioning math. -->
                                <FontString parentKey="Numbers" inherits="LDK_CodeEditorFont"
                                            justifyH="RIGHT" justifyV="TOP">
                                    <Anchors>
                                        <Anchor point="TOPLEFT"/>
                                        <Anchor point="TOPRIGHT" x="-4"/>
                                    </Anchors>
                                </FontString>
                            </Layer>
                        </Layers>
                    </Frame>
                </ScrollChild>
            </ScrollFrame>

            <Frame parentKey="CodeBackdrop" inherits="BackdropTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.GutterBackdrop" relativePoint="TOPRIGHT" x="0" y="0"/>
                    <Anchor point="BOTTOMRIGHT" relativeKey="$parent.BottomBar" relativePoint="TOPRIGHT" x="-28" y="0"/>
                </Anchors>
            </Frame>

            <!-- Code area: no-wrap EditBox inside a scroll frame (vertical scrollbar via UIPanelScrollFrameTemplate) -->
            <ScrollFrame parentKey="ScrollFrame" inherits="UIPanelScrollFrameTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.CodeBackdrop" relativePoint="TOPLEFT" x="5" y="-5"/>
                    <Anchor point="BOTTOMRIGHT" relativeKey="$parent.CodeBackdrop" relativePoint="BOTTOMRIGHT" x="-5" y="5"/>
                </Anchors>
                <Scripts>
                    <!-- Focus fallback, mirroring Blizzard's InputScrollFrame_OnMouseDown
                         on UIPanelInputScrollFrameTemplate. The ScrollFrame sits below
                         CodeEditBox (its ScrollChild, so a higher frame level), which
                         means clicks landing on the text still reach the EditBox and
                         position the caret natively; only clicks that miss it land
                         here and get focus forwarded. -->
                    <OnMouseDown>
                        self.CodeEditBox:SetFocus()
                    </OnMouseDown>
                    <OnLoad>
                        -- Chain, don't clobber: UIPanelScrollFrameCodeTemplate wires
                        -- OnVerticalScroll to ScrollFrame_OnVerticalScroll, which syncs
                        -- the scrollbar's value and its up/down button states. Replacing
                        -- it outright left the scrollbar desynced from the real scroll
                        -- offset (WowLua's own handler does this same sync by hand).
                        self:SetScript("OnVerticalScroll", function(sf, offset)
                            ScrollFrame_OnVerticalScroll(sf, offset)
                            self:GetParent():OnCodeEditBoxScroll(offset)
                        end)
                        -- viewport resize (SizerSE drag) moves wrap points in wrap mode
                        self:SetScript("OnSizeChanged", function(sf)
                            self:GetParent():OnCodeViewportSizeChanged()
                        end)
                    </OnLoad>
                </Scripts>
                <ScrollChild>
                    <!-- EditBox has its own font (SetFontObject/GetFont), set from Lua
                         OnLoad  no nested FontString element needed. -->
                    <EditBox parentKey="CodeEditBox" mixin="LDK_CodeEditBoxMixin"

                             multiLine="true" letters="0">
                        <Size x="4000" y="1"/>
                        <Anchors>
                            <Anchor point="TOPLEFT"/>
                            <Anchor point="TOPRIGHT"/>
                        </Anchors>
                        <Scripts>
                            <OnLoad method="OnLoad"/>
                            <OnEscapePressed method="OnEscapePressed"/>
                            <OnTextChanged method="OnTextChanged"/>
                            <OnCursorChanged method="OnCursorChanged"/>
                            <!-- Deliberately NO OnSizeChanged here. RefreshGutter is
                                 the only thing that ever resizes this EditBox, so an
                                 OnSizeChanged handler would only ever react to our own
                                 writes and call RefreshGutter again; a pure feedback
                                 edge that looped every frame and kept the caret from
                                 rendering. Real refresh triggers are covered by
                                 OnTextChanged, the ScrollFrame's OnSizeChanged
                                 (OnCodeViewportSizeChanged), SetWrapText and
                                 ApplyCodeFont. -->
                        </Scripts>
                    </EditBox>
                </ScrollChild>
            </ScrollFrame>

            <!-- Focus grabber, mirroring WowLua's $parentEditFocusGrabber: catches
                 clicks that miss CodeEditBox's own hit-rect and forwards focus.
                 CodeEditBox is a ScrollChild (frame level ScrollFrame+1) so it
                 outranks this sibling and still takes clicks that land on text,
                 keeping native click-to-position and drag-select intact. -->
            <Button parentKey="EditFocusGrabber">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.CodeBackdrop" relativePoint="TOPLEFT"/>
                    <Anchor point="BOTTOMRIGHT" relativeKey="$parent.CodeBackdrop" relativePoint="BOTTOMRIGHT"/>
                </Anchors>
                <Scripts>
                    <OnClick>
                        print('xx focused..')
                        self:GetParent().ScrollFrame.CodeEditBox:SetFocus()
                    </OnClick>
                </Scripts>
            </Button>
        </Frames>
    </Frame>

    <Frame name="LDK_CodeEditorDialog" hidden="true" movable="true" enableMouse="true"
           inherits="BackdropTemplate, LDK_CodeEditorDialogTemplate">
    </Frame>
</Ui>