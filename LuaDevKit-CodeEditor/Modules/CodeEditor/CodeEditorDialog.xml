<!--suppress ALL -->

<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">

    <!-- Placeholder base: the FontString below inherits this only so it
         has a valid font at XML-load time. FontUtil builds the real, catalog-
         driven font objects at runtime (see Libs/Modules/FontUtil.lua), and
         ApplyCodeFont() overrides it via SetFontObject as soon
         as the dialog configures, so this definition's own look never shows. -->
    <Font name="LDK_CodeEditorFont" inherits="SharedMediaFontsMono_DefaultFont"/>

    <!-- Command line prompt arrow: one fixed face on every client, so the
         glyph never changes with the code font or locale. -->
    <Font name="LDK_CommandPromptFont"
          font="Interface/AddOns/SharedMediaFontsMono/Assets/Fonts/JetBrainsMono-Medium.ttf" height="12"/>

    <Script file="ExampleCode.lua"/>
    <Script file="CodeEditBoxMixin.lua"/>
    <Script file="MinimalScrollBarStyle.lua"/>
    <Script file="CodeEditorDialog.lua"/>

    <!-- Copy of Blizzard_EventTrace's EventTraceMenuButtonTemplate; that
         addon is load-on-demand, so its template can't be inherited.
         MouseoverOverlay: same atlas, additive, shown on hover. -->
    <Button name="LDK_MenuButtonTemplate" virtual="true">
        <Size x="80" y="20"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="NormalTexture" atlas="auctionhouse-nav-button" useAtlasSize="false">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="-2" y="0"/>
                        <Anchor point="BOTTOMRIGHT" x="2" y="-12"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <Texture parentKey="MouseoverOverlay" hidden="true" atlas="auctionhouse-nav-button" useAtlasSize="false" alphaMode="ADD"/>
                <FontString parentKey="Label" inherits="GameFontHighlight">
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Scripts>
            <OnEnter>self.MouseoverOverlay:Show()</OnEnter>
            <OnLeave>self.MouseoverOverlay:Hide()</OnLeave>
        </Scripts>
    </Button>

    <Frame name="LDK_CodeEditorDialog" parent="UIParent" inherits="BackdropTemplate"
           mixin="LDK_CodeEditorDialogMixin"
           hidden="true" movable="true" resizable="true" enableMouse="true"
           enableKeyboard="true" frameStrata="DIALOG" toplevel="true"
           clampedToScreen="true">

        <Size x="600" y="400"/>
        <Anchors>
            <Anchor point="CENTER" x="0" y="0"/>
        </Anchors>

        <Scripts>
            <OnLoad method="OnLoad"/>
            <OnShow method="OnShow"/>
            <OnSizeChanged method="OnSizeChanged"/>
            <OnKeyDown method="OnKeyDown"/>
        </Scripts>

        <Frames>
            <!-- Header: full-width bar owning the title and close button;
                 drag-to-move lives here. CloseFrame declared before Title so
                 Title's right edge can anchor to it (fixed close, fluid
                 title).

                 Header.CloseFrame: no enableMouse, so drags over its empty
                 margin fall through to Header; the button still takes its
                 own clicks.

                 Header.CloseFrame.CloseButton: OnClick wired in Lua OnLoad,
                 not here, since the inherited UIPanelCloseButton_OnClick
                 hides GetParent() (CloseFrame at this depth).

                 Header.OptionsButton: plain arrow-only template (no natural
                 per-item icon, so no chrome to hide); lives here, not in
                 TopBar, so its Show Toolbar item stays reachable. -->
            <Frame parentKey="Header" inherits="BackdropTemplate" enableMouse="true">
                <Size y="28"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="$parent" x="-2" y="1"/>
                    <Anchor point="TOPRIGHT" relativeTo="$parent" x="2" y="-1"/>
                </Anchors>
                <Frames>
                    <Frame parentKey="CloseFrame" inherits="BackdropTemplate">
                        <Size x="28" />
                        <Anchors>
                            <Anchor point="TOPRIGHT"/>
                            <Anchor point="BOTTOMRIGHT"/>
                        </Anchors>
                        <Frames>
                            <Button parentKey="CloseButton" inherits="UIPanelCloseButton">
                                <Anchors>
                                    <Anchor point="CENTER" x="-1" y="0"/>
                                </Anchors>
                            </Button>
                        </Frames>
                    </Frame>
                    <DropdownButton parentKey="OptionsButton" inherits="WowStyle1ArrowDropdownTemplate">
                        <KeyValues>
                            <KeyValue key="menuMixin" value="MenuStyle2Mixin" type="global"/>
                        </KeyValues>
                        <Anchors>
                            <Anchor point="RIGHT" relativeKey="$parent.CloseFrame" relativePoint="LEFT" x="0" y="0"/>
                        </Anchors>
                    </DropdownButton>
                    <Frame parentKey="Title" inherits="BackdropTemplate">
                        <Anchors>
                            <Anchor point="TOPLEFT"/>
                            <Anchor point="BOTTOMRIGHT" relativeKey="$parent.CloseFrame" relativePoint="BOTTOMLEFT" x="5"/>
                        </Anchors>
                        <Layers>
                            <Layer level="ARTWORK">
                                <FontString parentKey="Text" inherits="GameFontNormalSmall"
                                            justifyH="CENTER">
                                    <Anchors>
                                        <Anchor point="LEFT" x="4" y="0"/>
                                        <Anchor point="RIGHT" x="40" y="0"/>
                                    </Anchors>
                                </FontString>
                            </Layer>
                        </Layers>
                    </Frame>
                </Frames>
                <Scripts>
                    <OnMouseDown>
                        if button == "LeftButton" then
                        self:GetParent():StartMoving()
                        end
                    </OnMouseDown>
                    <OnMouseUp>
                        self:GetParent():StopMovingOrSizing()
                    </OnMouseUp>
                </Scripts>
            </Frame>

            <!-- SizerSE: bottom-right resize grip, styled like AceGUI's Frame
                 widget sizer_se.

                 SizerSE.Line1/Line2: diagonal tex-coords set in Lua OnLoad
                 (SetTexCoord's 8-value quad form isn't expressible in XML). -->
            <Frame parentKey="SizerSE" enableMouse="true">
                <Size x="25" y="25"/>
                <Anchors>
                    <Anchor point="BOTTOMRIGHT"/>
                </Anchors>
                <Layers>
                    <Layer level="BACKGROUND">
                        <Texture hidden="false" parentKey="Line1" file="Interface\Tooltips\UI-Tooltip-Border">
                            <Size x="14" y="14"/>
                            <Anchors>
                                <Anchor point="BOTTOMRIGHT" x="-4" y="4"/>
                            </Anchors>
                        </Texture>
                        <Texture hidden="false" parentKey="Line2" file="Interface\Tooltips\UI-Tooltip-Border">
                            <Size x="6" y="6"/>
                            <Anchors>
                                <Anchor point="BOTTOMRIGHT" x="-6" y="6"/>
                            </Anchors>
                        </Texture>
                    </Layer>
                </Layers>
                <Scripts>
                    <OnMouseDown>
                        self:GetParent():StartSizing("BOTTOMRIGHT")
                    </OnMouseDown>
                    <OnMouseUp>
                        self:GetParent():StopMovingOrSizing()
                        self:GetParent():ClampToScreen()
                    </OnMouseUp>
                </Scripts>
            </Frame>

            <!-- TopBar: toolbar. Document controls on the left; font size,
                 font and theme dropdowns on the right. Hideable: Lua's
                 SetToolbarShown collapses it and the code area moves up.

                 TopBar.NewButton and TopBar.ThemeButton are pinned above CodeBackdrop's
                 top corners in Lua's OnLoad_ToolbarEdges. Icon sizes, the
                 stepper height and the bar height come from Lua's LayoutToolbar.

                 TopBar.SaveButton, TopBar.DeleteButton: each chained off the
                 button before it in Lua. SaveButton is disabled (greyed) while
                 the document has no unsaved changes; see RefreshDirtyMark.

                 TopBar.DocStepper: Blizzard's dropdown with steppers; its
                 template requires the Dropdown child declared here. Its back
                 arrow and Dropdown are chained off DeleteButton in Lua. -->
            <Frame parentKey="TopBar" inherits="BackdropTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.Header" relativePoint="BOTTOMLEFT" x="0" y="-2"/>
                    <Anchor point="TOPRIGHT" relativeKey="$parent.Header" relativePoint="BOTTOMRIGHT" x="0" y="0"/>
                </Anchors>
                <Frames>
                    <Button parentKey="NewButton">
                        <NormalTexture file="interface\addons\luadevkit\assets\new-btn"/>
                        <HighlightTexture file="interface\addons\luadevkit\assets\new-btn" alphaMode="ADD"/>
                    </Button>
                    <Button parentKey="SaveButton">
                        <Anchors>
                            <Anchor point="LEFT" relativeKey="$parent.NewButton" relativePoint="RIGHT"/>
                        </Anchors>
                        <NormalTexture file="interface\addons\luadevkit\assets\save-btn"/>
                        <DisabledTexture file="interface\addons\luadevkit\assets\save-btn-disabled"/>
                        <HighlightTexture file="interface\addons\luadevkit\assets\save-btn" alphaMode="ADD"/>
                    </Button>
                    <Button parentKey="DeleteButton">
                        <Anchors>
                            <Anchor point="LEFT" relativeKey="$parent.SaveButton" relativePoint="RIGHT"/>
                        </Anchors>
                        <NormalTexture file="interface\addons\luadevkit\assets\delete-btn"/>
                        <HighlightTexture file="interface\addons\luadevkit\assets\delete-btn" alphaMode="ADD"/>
                    </Button>
                    <Frame parentKey="DocStepper" inherits="DropdownWithSteppersTemplate">
                        <Size x="200" y="26"/>
                        <Anchors>
                            <Anchor point="LEFT" relativeKey="$parent.DeleteButton" relativePoint="RIGHT"/>
                        </Anchors>
                        <KeyValues>
                            <KeyValue key="decrementOffsetX" value="-2" type="number"/>
                            <KeyValue key="incrementOffsetX" value="2" type="number"/>
                        </KeyValues>
                        <Frames>
                            <DropdownButton parentKey="Dropdown" inherits="WowStyle2DropdownTemplate"/>
                        </Frames>
                    </Frame>
                    <DropdownButton parentKey="ThemeButton" inherits="WowStyle1DropdownTemplate">
                        <KeyValues>
                            <KeyValue key="menuMixin" value="MenuStyle2Mixin" type="global"/>
                        </KeyValues>
                        <NormalTexture file="interface\addons\luadevkit\assets\theme-btn.tga"/>
                        <HighlightTexture file="interface\addons\luadevkit\assets\theme-btn.tga" alphaMode="ADD"/>
                    </DropdownButton>
                    <DropdownButton parentKey="FontButton" inherits="WowStyle1DropdownTemplate">
                        <KeyValues>
                            <KeyValue key="menuMixin" value="MenuStyle2Mixin" type="global"/>
                        </KeyValues>
                        <NormalTexture file="interface\addons\luadevkit\assets\font-btn.tga"/>
                        <HighlightTexture file="interface\addons\luadevkit\assets\font-btn.tga" alphaMode="ADD"/>
                    </DropdownButton>
                    <DropdownButton parentKey="FontSizeButton" inherits="WowStyle1DropdownTemplate">
                        <KeyValues>
                            <KeyValue key="menuMixin" value="MenuStyle2Mixin" type="global"/>
                        </KeyValues>
                        <NormalTexture file="interface\addons\luadevkit\assets\font-size-btn.tga"/>
                        <HighlightTexture file="interface\addons\luadevkit\assets\font-size-btn.tga" alphaMode="ADD"/>
                    </DropdownButton>
                </Frames>
            </Frame>

            <!-- BottomBar: status/action bar. -->
            <Frame parentKey="BottomBar" inherits="BackdropTemplate">
                <Size y="24"/>
                <Anchors>
                    <Anchor point="BOTTOMLEFT" relativeTo="$parent" x="0" y="8"/>
                    <Anchor point="BOTTOMRIGHT" relativeTo="$parent" x="0" y="8"/>
                </Anchors>
                <Frames>
                    <CheckButton parentKey="WrapCheckButton" inherits="UICheckButtonTemplate">
                        <Size x="24" y="24"/>
                        <Anchors>
                            <Anchor point="LEFT" x="14" y="0"/>
                        </Anchors>
                        <Scripts>
                            <OnClick>
                                self:GetParent():GetParent():OnWrapToggled(self:GetChecked())
                            </OnClick>
                        </Scripts>
                    </CheckButton>
                </Frames>
            </Frame>

            <!-- CommandBar: single-line quick-eval input, mirroring WowLua's
                 own prompt (third-party/wowlua/WowLua.lua); sits on
                 BottomBar, below the output panel.

                 CommandBar.CommandEditBox: plain EditBox, not
                 LDK_CodeEditBoxMixin, wired straight to the dialog like
                 WrapCheckButton. No native history (no historyLines): Lua's
                 commandHistory is the only list, stepped by StepCommandHistory.
                 It's the bar's height and centered on Prompt, so its text lines
                 up with the prompt at any font size.

                 CommandBar.Prompt: fixed LDK_CommandPromptFont, not the code
                 font, so the arrow keeps one shape; ApplyCodeFont leaves it alone.
                 Anchored per theme in Lua's ApplyConsoleInsets.

                 CommandBar.HistoryButton: arrow dropdown listing that history,
                 set up in Lua's OnLoad_HistoryButton; right-aligned with the
                 console settings gear in ApplyConsoleInsets. -->
            <Frame parentKey="CommandBar" inherits="BackdropTemplate">
                <Size y="22"/>
                <Anchors>
                    <Anchor point="BOTTOMLEFT" relativeKey="$parent.BottomBar" relativePoint="TOPLEFT" x="0" y="0"/>
                    <Anchor point="BOTTOMRIGHT" relativeKey="$parent.BottomBar" relativePoint="TOPRIGHT" x="0" y="0"/>
                </Anchors>
                <Layers>
                    <Layer level="ARTWORK">
                        <FontString parentKey="Prompt" inherits="LDK_CommandPromptFont" justifyH="LEFT"/>
                    </Layer>
                </Layers>
                <Frames>
                    <DropdownButton parentKey="HistoryButton" inherits="WowStyle1ArrowDropdownTemplate">
                        <KeyValues>
                            <KeyValue key="menuMixin" value="MenuStyle2Mixin" type="global"/>
                        </KeyValues>
                    </DropdownButton>
                    <EditBox parentKey="CommandEditBox" letters="4096"
                             autoFocus="false">
                        <Size y="22"/>
                        <Anchors>
                            <Anchor point="LEFT" relativeKey="$parent.Prompt" relativePoint="RIGHT" x="0" y="0"/>
                            <Anchor point="RIGHT" relativeKey="$parent.HistoryButton" relativePoint="LEFT" x="-4" y="0"/>
                        </Anchors>
                        <Scripts>
                            <OnEnterPressed>
                                local text = self:GetText()
                                self:SetText('')
                                self:GetParent():GetParent():OnCommandEnterPressed(text)
                            </OnEnterPressed>
                            <OnEscapePressed>
                                self:ClearFocus()
                            </OnEscapePressed>
                        </Scripts>
                    </EditBox>
                </Frames>
            </Frame>

            <!-- StatusBar: output panel, results appended run after run;
                 StatusDivider sets its height.

                 StatusBar.OutputScrollFrame: plain ScrollFrame, no template,
                 so the panel keeps its scrollbar-free look; wheel, sizing and
                 auto scroll to bottom are wired in Lua's OnLoad_StatusBar.

                 OutputScrollFrame OnMouseDown: clicks that miss EvalStatus
                 forward focus to it.

                 OutputScrollFrame.ScrollChild: sized in Lua's RefreshOutput
                 and floored at the viewport height, so short output still
                 sits on the panel's bottom edge.

                 OutputScrollFrame.ScrollChild.EvalStatus: EditBox, not a
                 ScrollingMessageFrame, which has no way to select text; hangs
                 off the child's bottom and grows upward with its own text;
                 kept read-only in Lua's OnEvalStatusTextChanged.

                 StatusBar.ConsoleSettingsButton: floating gear menu for console
                 font and size; raised in Lua's OnLoad_Overlays, anchored per
                 theme in ApplyConsoleInsets, faded in ApplyToolIconAlpha.

                 StatusBar.ClearOutputButton: empties the output panel; sits
                 below the gear and shares its raise and fade. -->
            <Frame parentKey="StatusBar" inherits="BackdropTemplate">
                <Size y="100"/>
                <Anchors>
                    <Anchor point="BOTTOMLEFT" relativeKey="$parent.CommandBar" relativePoint="TOPLEFT" x="0" y="0"/>
                    <Anchor point="BOTTOMRIGHT" relativeKey="$parent.CommandBar" relativePoint="TOPRIGHT" x="0" y="0"/>
                </Anchors>
                <Frames>
                    <ScrollFrame parentKey="OutputScrollFrame" enableMouse="true">
                        <Anchors>
                            <Anchor point="TOPLEFT" x="6" y="-4"/>
                            <Anchor point="BOTTOMRIGHT" x="-4" y="4"/>
                        </Anchors>
                        <Scripts>
                            <OnMouseDown>
                                self.ScrollChild.EvalStatus:SetFocus()
                            </OnMouseDown>
                        </Scripts>
                        <ScrollChild>
                            <Frame parentKey="ScrollChild">
                                <Size x="1" y="1"/>
                                <Anchors>
                                    <Anchor point="TOPLEFT"/>
                                </Anchors>
                                <Frames>
                                    <EditBox parentKey="EvalStatus" multiLine="true" autoFocus="false">
                                        <Anchors>
                                            <Anchor point="BOTTOMLEFT"/>
                                            <Anchor point="BOTTOMRIGHT"/>
                                        </Anchors>
                                        <Scripts>
                                            <OnEscapePressed>
                                                self:ClearFocus()
                                            </OnEscapePressed>
                                        </Scripts>
                                    </EditBox>
                                </Frames>
                            </Frame>
                        </ScrollChild>
                    </ScrollFrame>
                    <DropdownButton parentKey="ConsoleSettingsButton">
                        <Size x="16" y="16"/>
                        <KeyValues>
                            <KeyValue key="menuMixin" value="MenuStyle2Mixin" type="global"/>
                        </KeyValues>
                        <NormalTexture file="Interface\Icons\INV_Misc_Gear_01"/>
                        <HighlightTexture file="Interface\Icons\INV_Misc_Gear_01" alphaMode="ADD"/>
                    </DropdownButton>
                    <Button parentKey="ClearOutputButton">
                        <Size x="12" y="12"/>
                        <Anchors>
                            <Anchor point="TOP" relativeKey="$parent.ConsoleSettingsButton" relativePoint="BOTTOM" x="0" y="-4"/>
                        </Anchors>
                        <NormalTexture file="interface\addons\luadevkit\assets\clear-btn"/>
                        <HighlightTexture file="interface\addons\luadevkit\assets\clear-btn" alphaMode="ADD"/>
                    </Button>
                </Frames>
            </Frame>

            <!-- StatusDivider: drag handle, resizes StatusBar;
                 double-click toggles it between max and min.
                 GutterBackdrop/CodeBackdrop anchor to its top.

                 StatusDivider.Grip: colored in Lua's ApplyTheme, like every
                 other border here.

                 StatusDivider.MinimizeButton/MaximizeButton: jump the output
                 panel to its max/min height; rotated and wired in Lua's
                 OnLoad_StatusBar. They flank the Grip, Minimize on its left.

                 StatusDivider.RunButton: runs the buffer; same arrow art
                 turned into a play icon in Lua's OnLoad_RunButton;
                 anchored over the code area in OnLoad_Overlays. -->
            <Button parentKey="StatusDivider" enableMouse="true">
                <Size y="10"/>
                <Anchors>
                    <Anchor point="BOTTOMLEFT" relativeKey="$parent.StatusBar" relativePoint="TOPLEFT" x="0" y="0"/>
                    <Anchor point="BOTTOMRIGHT" relativeKey="$parent.StatusBar" relativePoint="TOPRIGHT" x="0" y="0"/>
                </Anchors>
                <Layers>
                    <Layer level="ARTWORK">
                        <Texture parentKey="Grip">
                            <Size x="89" y="3"/>
                            <Anchors>
                                <Anchor point="CENTER"/>
                            </Anchors>
                        </Texture>
                    </Layer>
                </Layers>
                <Frames>
                    <Button parentKey="MinimizeButton">
                        <Size x="8" y="15"/>
                        <Anchors>
                            <Anchor point="RIGHT" relativeKey="$parent.Grip" relativePoint="LEFT" x="-8" y="-0.5"/>
                        </Anchors>
                        <NormalTexture parentKey="NormalTexture" atlas="bag-arrow"/>
                        <PushedTexture atlas="bag-arrow"/>
                        <DisabledTexture atlas="bag-arrow" desaturated="true" alpha="0.58"/>
                        <HighlightTexture atlas="bag-arrow" alpha="0.9" alphaMode="ADD"/>
                    </Button>
                    <Button parentKey="MaximizeButton">
                        <Size x="8" y="15"/>
                        <Anchors>
                            <Anchor point="LEFT" relativeKey="$parent.Grip" relativePoint="RIGHT" x="8" y="0.5"/>
                        </Anchors>
                        <NormalTexture parentKey="NormalTexture" atlas="bag-arrow"/>
                        <PushedTexture atlas="bag-arrow"/>
                        <DisabledTexture atlas="bag-arrow" desaturated="true" alpha="0.58"/>
                        <HighlightTexture atlas="bag-arrow" alpha="0.9" alphaMode="ADD"/>
                    </Button>
                    <Button parentKey="RunButton">
                        <Size x="16" y="14"/>
                        <NormalTexture parentKey="NormalTexture" atlas="bag-arrow"/>
                        <PushedTexture atlas="bag-arrow"/>
                        <DisabledTexture atlas="bag-arrow" desaturated="true" alpha="0.58"/>
                        <HighlightTexture atlas="bag-arrow" alpha="0.9" alphaMode="ADD"/>
                    </Button>
                </Frames>
                <Scripts>
                    <OnLoad>
                        self.owner = self:GetParent()
                    </OnLoad>
                    <OnMouseDown>
                        if button == "LeftButton" then
                          self.owner:OnStatusDividerMouseDown()
                        end
                    </OnMouseDown>
                    <OnMouseUp>
                        self.owner:OnStatusDividerMouseUp()
                    </OnMouseUp>
                    <OnDoubleClick>
                        self.owner:ToggleStatus()
                    </OnDoubleClick>
                    <OnEnter>
                        self.owner:OnStatusDividerHover(true)
                    </OnEnter>
                    <OnLeave>
                        self.owner:OnStatusDividerHover(false)
                    </OnLeave>
                </Scripts>
            </Button>

            <!-- Hidden measuring string: same font/wrap as CodeEditBox, for GetNumLines(). -->
            <Frame parentKey="WrapMeasure" hidden="true">
                <Size x="1" y="1"/>
                <Layers>
                    <Layer level="ARTWORK">
                        <FontString parentKey="Text" inherits="LDK_CodeEditorFont"
                                    justifyH="LEFT" justifyV="TOP" wordwrap="true">
                            <Anchors>
                                <Anchor point="TOPLEFT"/>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>

            <!-- Border backing frame: keep its top inset equal to code's or rows drift. -->
            <Frame parentKey="GutterBackdrop" inherits="BackdropTemplate">
                <Size x="34" y="1"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.TopBar" relativePoint="BOTTOMLEFT" x="16" y="0"/>
                    <Anchor point="BOTTOMLEFT" relativeKey="$parent.StatusDivider" relativePoint="TOPLEFT" x="16" y="0"/>
                </Anchors>
            </Frame>

            <!-- Gutter: real ScrollFrame, clips and stays locked to the code
                 area's scroll; anchored/inset in Lua's OnLoad_Viewports.

                 Gutter.ScrollChild: sized in Lua's RefreshGutter, so TOPLEFT
                 is its only anchor (a second would fight that sizing).

                 Gutter.ScrollChild.Numbers: EditBox, not FontString (those
                 truncate past ~30k chars); font matches CodeEditBox for
                 identical line pitch. -->
            <ScrollFrame parentKey="Gutter">
                <ScrollChild>
                    <Frame parentKey="ScrollChild">
                        <Size x="1" y="1"/>
                        <Anchors>
                            <Anchor point="TOPLEFT"/>
                        </Anchors>
                        <Frames>
                            <EditBox parentKey="Numbers" multiLine="true"
                                     enableMouseClicks="false"
                                     autoFocus="false" enableMouse="false" enableKeyboard="false">
                                <Anchors>
                                    <Anchor point="TOPLEFT"/>
                                    <Anchor point="BOTTOMRIGHT"/>
                                </Anchors>
                            </EditBox>
                        </Frames>
                    </Frame>
                </ScrollChild>
            </ScrollFrame>

            <!-- CodeBackdrop: x=-1 overlaps the gutter's border (avoids a
                 double border).

                 ScrollBarGap: widening its Size x opens a real gap before
                 the scrollbar.

                 ScrollFrame: code area, no-wrap EditBox in a scroll frame
                 (vertical scrollbar via UIPanelScrollFrameTemplate);
                 anchored/inset in Lua's OnLoad_Viewports.

                 ScrollFrame OnMouseDown: clicks that miss CodeEditBox
                 forward focus to it.

                 ScrollFrame OnLoad: chains OnVerticalScroll (replacing it
                 outright desynced the scrollbar) and OnSizeChanged (a SizerSE
                 drag moves wrap points in wrap mode).

                 ScrollFrame.CodeEditBox: has its own font (SetFontObject/
                 GetFont), no nested FontString needed; no OnSizeChanged
                 wired since RefreshGutter is the only resizer and wiring it
                 here would self-loop. -->
            <Frame parentKey="CodeBackdrop" inherits="BackdropTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.GutterBackdrop" relativePoint="TOPRIGHT" x="-1" y="0"/>
                    <Anchor point="BOTTOMRIGHT" relativeKey="$parent.StatusDivider" relativePoint="TOPRIGHT" x="-29" y="0"/>
                </Anchors>
            </Frame>

            <Frame parentKey="ScrollBarGap">
                <Size x="3"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.CodeBackdrop" relativePoint="TOPRIGHT" x="0" y="0"/>
                    <Anchor point="BOTTOMLEFT" relativeKey="$parent.CodeBackdrop" relativePoint="BOTTOMRIGHT" x="0" y="0"/>
                </Anchors>
            </Frame>

            <ScrollFrame parentKey="ScrollFrame" inherits="UIPanelScrollFrameTemplate">
                <Scripts>
                    <OnMouseDown>
                        self.CodeEditBox:SetFocus()
                    </OnMouseDown>
                    <OnLoad>
                        self:SetScript("OnVerticalScroll", function(sf, offset)
                            ScrollFrame_OnVerticalScroll(sf, offset)
                            self:GetParent():OnCodeEditBoxScroll(offset)
                        end)
                        self:SetScript("OnSizeChanged", function(sf)
                            self:GetParent():OnCodeViewportSizeChanged()
                        end)
                    </OnLoad>
                </Scripts>
                <ScrollChild>
                    <EditBox parentKey="CodeEditBox" mixin="LDK_CodeEditBoxMixin"
                             frameBuffer="true" countInvisibleLetters="true" multiLine="true">
                        <Size x="4000" y="1"/>
                        <Anchors>
                            <Anchor point="TOPLEFT"/>
                            <Anchor point="TOPRIGHT"/>
                        </Anchors>
                        <Scripts>
                            <OnLoad method="OnLoad"/>
                            <OnEscapePressed method="OnEscapePressed"/>
                            <OnTextChanged method="OnTextChanged"/>
                            <OnCursorChanged method="OnCursorChanged"/>
                            <OnKeyDown method="OnKeyDown"/>
                        </Scripts>
                    </EditBox>
                </ScrollChild>
            </ScrollFrame>

            <!-- FontSteppers: floating font size buttons over the code
                 area's top right.
                 FontSteppers.MinusButton/PlusButton: Assets plus/minus art;
                 wired and raised in Lua's OnLoad_FontSteppers; anchored in
                 OnLoad_Overlays. -->
            <Frame parentKey="FontSteppers">
                <Size x="32" y="10"/>
                <Frames>
                    <Button parentKey="PlusButton">
                        <Size x="12" y="12"/>
                        <Anchors>
                            <Anchor point="RIGHT" x="0" y="0"/>
                        </Anchors>
                        <NormalTexture file="interface\addons\luadevkit\assets\plus-btn" alpha="0.7"/>
                        <DisabledTexture file="interface\addons\luadevkit\assets\plus-btn-disabled"/>
                        <HighlightTexture file="interface\addons\luadevkit\assets\plus-btn" alphaMode="ADD"/>
                    </Button>
                    <Button parentKey="MinusButton">
                        <Size x="10" y="12"/>
                        <Anchors>
                            <Anchor point="RIGHT" relativeKey="$parent.PlusButton" relativePoint="LEFT" x="-5" y="0"/>
                        </Anchors>
                        <NormalTexture file="interface\addons\luadevkit\assets\minus-btn" alpha="0.7"/>
                        <DisabledTexture file="interface\addons\luadevkit\assets\minus-btn-disabled"/>
                        <HighlightTexture file="interface\addons\luadevkit\assets\minus-btn" alphaMode="ADD"/>
                    </Button>
                </Frames>
            </Frame>

            <!-- Border: the main edge art, split off the dialog's own
                 backdrop in ApplyTheme so it draws over StatusBar and
                 CommandBar; raised in Lua's OnLoad_Border. -->
            <Frame parentKey="Border" inherits="BackdropTemplate" setAllPoints="true"/>

            <!-- OptionsTip: one-time tip pointing at Header.OptionsButton; shown
                 in Lua's OnShow, dismissed by its close button or by opening
                 the Options menu. -->
            <Frame parentKey="OptionsTip" inherits="LDK_HelpTipTemplate">
                <KeyValues>
                    <KeyValue key="tipKey" value="OptionsMenu"/>
                    <KeyValue key="textKey" value="Options::HelpTip"/>
                </KeyValues>
            </Frame>
        </Frames>
    </Frame>
</Ui>