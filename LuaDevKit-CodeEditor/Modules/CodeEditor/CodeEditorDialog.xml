<!--suppress ALL -->

<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">

    <!-- Placeholder base: the two FontStrings below inherit this only so they
         have a valid font at XML-load time. FontUtil builds the real, catalog-
         driven font objects at runtime (see Libs/Fonts/FontUtil.lua), and
         ApplyCodeFont() overrides both FontStrings via SetFontObject as soon
         as the dialog configures, so this definition's own look never shows. -->
    <Font name="LDK_CodeEditorFont" inherits="SharedMediaFontsMono_DefaultFont"/>
    <Script file="ExampleCode.lua"/>
    <Script file="CodeEditBoxMixin.lua"/>
    <Script file="CodeEditorDialog.lua"/>

    <Frame name="LDK_CodeEditorDialogTemplate" virtual="true"
           mixin="LDK_CodeEditorDialogMixin"
           hidden="true" movable="true" resizable="true" enableMouse="true"
           enableKeyboard="true" frameStrata="DIALOG" toplevel="true"
           clampedToScreen="true">

        <Size x="600" y="400"/>
        <Anchors>
            <Anchor point="CENTER" x="0" y="0"/>
        </Anchors>

        <Scripts>
            <OnLoad method="OnLoad"/>
            <OnShow method="OnShow"/>
            <OnSizeChanged method="OnSizeChanged"/>
            <OnKeyDown method="OnKeyDown"/>
        </Scripts>

        <Frames>
            <!-- Header row: full-width bar owning the title and the close button.
                 Drag-to-move lives here (it was on the old header Texture).
                 CloseFrame is declared before Title so Title's right edge can
                 anchor to it: fixed-width close + fluid title means the title
                 absorbs all remaining width. -->
            <Frame parentKey="Header" inherits="BackdropTemplate" enableMouse="true">
                <Size y="28"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="$parent" x="-2" y="1"/>
                    <Anchor point="TOPRIGHT" relativeTo="$parent" x="2" y="-1"/>
                </Anchors>
                <Frames>
                    <!-- No enableMouse: drags over its empty margin fall through
                         to Header; the Button still takes its own clicks. -->
                    <Frame parentKey="CloseFrame" inherits="BackdropTemplate">
                        <Size x="28" />
                        <Anchors>
                            <Anchor point="TOPRIGHT"/>
                            <Anchor point="BOTTOMRIGHT"/>
                        </Anchors>
                        <Frames>
                            <!-- OnClick is wired in Lua OnLoad, not here: the
                                 inherited UIPanelCloseButton_OnClick hides
                                 GetParent(), which at this depth is CloseFrame. -->
                            <Button parentKey="CloseButton" inherits="UIPanelCloseButton">
                                <Anchors>
                                    <Anchor point="CENTER" x="-1" y="0"/>
                                </Anchors>
                            </Button>
                        </Frames>
                    </Frame>
                    <Frame parentKey="Title" inherits="BackdropTemplate">
                        <Anchors>
                            <Anchor point="TOPLEFT"/>
                            <Anchor point="BOTTOMRIGHT" relativeKey="$parent.CloseFrame" relativePoint="BOTTOMLEFT" x="5"/>
                        </Anchors>
                        <Layers>
                            <Layer level="ARTWORK">
                                <FontString parentKey="Text" inherits="GameFontNormalSmall"
                                            justifyH="CENTER">
                                    <Anchors>
                                        <Anchor point="LEFT" x="4" y="0"/>
                                        <Anchor point="RIGHT" x="40" y="0"/>
                                    </Anchors>
                                </FontString>
                            </Layer>
                        </Layers>
                    </Frame>
                </Frames>
                <Scripts>
                    <OnMouseDown>
                        if button == "LeftButton" then
                        self:GetParent():StartMoving()
                        end
                    </OnMouseDown>
                    <OnMouseUp>
                        self:GetParent():StopMovingOrSizing()
                    </OnMouseUp>
                </Scripts>
            </Frame>

            <!-- Bottom-right resize grip, styled like AceGUI's Frame widget sizer_se -->
            <Frame parentKey="SizerSE" enableMouse="true">
                <Size x="25" y="25"/>
                <Anchors>
                    <Anchor point="BOTTOMRIGHT"/>
                </Anchors>
                <Layers>
                    <Layer level="BACKGROUND">
                        <!-- Diagonal tex-coords set in Lua OnLoad (SetTexCoord's 8-value quad form isn't expressible in XML) -->
                        <Texture hidden="false" parentKey="Line1" file="Interface\Tooltips\UI-Tooltip-Border">
                            <Size x="14" y="14"/>
                            <Anchors>
                                <Anchor point="BOTTOMRIGHT" x="-4" y="4"/>
                            </Anchors>
                        </Texture>
                        <Texture hidden="false" parentKey="Line2" file="Interface\Tooltips\UI-Tooltip-Border">
                            <Size x="6" y="6"/>
                            <Anchors>
                                <Anchor point="BOTTOMRIGHT" x="-6" y="6"/>
                            </Anchors>
                        </Texture>
                    </Layer>
                </Layers>
                <Scripts>
                    <OnMouseDown>
                        self:GetParent():StartSizing("BOTTOMRIGHT")
                    </OnMouseDown>
                    <OnMouseUp>
                        self:GetParent():StopMovingOrSizing()
                        self:GetParent():ClampToScreen()
                    </OnMouseUp>
                </Scripts>
            </Frame>

            <!-- Reserved space for future toolbar/controls (e.g. Accept/Run buttons) -->
            <Frame parentKey="TopBar" inherits="BackdropTemplate">
                <Size y="28"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.Header" relativePoint="BOTTOMLEFT" x="0" y="-2"/>
                    <Anchor point="TOPRIGHT" relativeKey="$parent.Header" relativePoint="BOTTOMRIGHT" x="0" y="0"/>
                </Anchors>
                <Frames>
                    <!-- Options/tools menu: no natural per-item icon, so the
                         plain arrow-only template fits (no chrome to hide). -->
                    <DropdownButton parentKey="OptionsButton" inherits="WowStyle1ArrowDropdownTemplate">
                        <KeyValues>
                            <KeyValue key="menuMixin" value="MenuStyle2Mixin" type="global"/>
                        </KeyValues>
                        <Anchors><Anchor point="RIGHT" x="-7" y="2"/></Anchors>
                    </DropdownButton>
                    <DropdownButton parentKey="ThemeButton" inherits="WowStyle1DropdownTemplate">
                        <KeyValues>
                            <KeyValue key="menuMixin" value="MenuStyle2Mixin" type="global"/>
                        </KeyValues>
                        <Size x="20" y="20"/>
                        <Anchors><Anchor point="RIGHT" relativeKey="$parent.OptionsButton" relativePoint="LEFT" x="2" y="0"/></Anchors>
                        <NormalTexture file="interface\addons\luadevkit\assets\theme-btn.tga"/>
                        <HighlightTexture file="interface\addons\luadevkit\assets\theme-btn.tga" alphaMode="ADD"/>
                    </DropdownButton>
                    <DropdownButton parentKey="FontButton" inherits="WowStyle1DropdownTemplate">
                        <KeyValues>
                            <KeyValue key="menuMixin" value="MenuStyle2Mixin" type="global"/>
                        </KeyValues>
                        <Size x="20" y="20"/>
                        <Anchors>
                            <Anchor point="RIGHT" relativeKey="$parent.ThemeButton" relativePoint="LEFT" x="-2" y="0"/>
                        </Anchors>
                        <NormalTexture file="interface\addons\luadevkit\assets\font-btn.tga"/>
                        <HighlightTexture file="interface\addons\luadevkit\assets\font-btn.tga" alphaMode="ADD"/>
                    </DropdownButton>
                    <DropdownButton parentKey="FontSizeButton" inherits="WowStyle1DropdownTemplate">
                        <KeyValues>
                            <KeyValue key="menuMixin" value="MenuStyle2Mixin" type="global"/>
                        </KeyValues>
                        <Size x="20" y="20"/>
                        <Anchors>
                            <Anchor point="RIGHT" relativeKey="$parent.FontButton" relativePoint="LEFT" x="-2" y="0"/>
                        </Anchors>
                        <NormalTexture file="interface\addons\luadevkit\assets\font-size-btn.tga"/>
                        <HighlightTexture file="interface\addons\luadevkit\assets\font-size-btn.tga" alphaMode="ADD"/>
                    </DropdownButton>
                    <!-- Step font size up/down, left of the size dropdown trigger.
                         Chat-frame scroll icons (same art Blizzard uses on
                         LootFrame's page buttons), not a scrollbar template. -->
                    <Button parentKey="FontSizeUpButton">
                        <Size x="20" y="26"/>
                        <Anchors>
                            <Anchor point="RIGHT" relativeKey="$parent.FontSizeButton" relativePoint="LEFT" x="-2" y="0"/>
                        </Anchors>
                        <NormalTexture file="Interface\ChatFrame\UI-ChatIcon-ScrollUp-Up"/>
                        <PushedTexture file="Interface\ChatFrame\UI-ChatIcon-ScrollUp-Down"/>
                        <DisabledTexture file="Interface\ChatFrame\UI-ChatIcon-ScrollUp-Disabled"/>
                        <HighlightTexture file="Interface\Buttons\UI-Common-MouseHilight" alphaMode="ADD"/>
                    </Button>
                    <Button parentKey="FontSizeDownButton">
                        <Size x="20" y="26"/>
                        <Anchors>
                            <Anchor point="RIGHT" relativeKey="$parent.FontSizeUpButton" relativePoint="LEFT" x="3" y="0"/>
                        </Anchors>
                        <NormalTexture file="Interface\ChatFrame\UI-ChatIcon-ScrollDown-Up"/>
                        <PushedTexture file="Interface\ChatFrame\UI-ChatIcon-ScrollDown-Down"/>
                        <DisabledTexture file="Interface\ChatFrame\UI-ChatIcon-ScrollDown-Disabled"/>
                        <HighlightTexture file="Interface\Buttons\UI-Common-MouseHilight" alphaMode="ADD"/>
                    </Button>
                </Frames>
            </Frame>

            <!-- Status/action bar -->
            <Frame parentKey="BottomBar" inherits="BackdropTemplate">
                <Size y="30"/>
                <Anchors>
                    <Anchor point="BOTTOMLEFT" relativeTo="$parent" x="0" y="16"/>
                    <Anchor point="BOTTOMRIGHT" relativeTo="$parent" x="0" y="16"/>
                </Anchors>
                <Frames>
                    <CheckButton parentKey="WrapCheckButton" inherits="UICheckButtonTemplate">
                        <Size x="24" y="24"/>
                        <Anchors>
                            <Anchor point="LEFT" x="14" y="0"/>
                        </Anchors>
                        <Scripts>
                            <OnClick>
                                self:GetParent():GetParent():OnWrapToggled(self:GetChecked())
                            </OnClick>
                        </Scripts>
                    </CheckButton>
                </Frames>
            </Frame>

            <!-- Output panel: evaluation results, appended run after run. Full
                 width like BottomBar, which it sits directly on top of. Its
                 height is the split point between the code area and this panel;
                 StatusDivider is what writes that height. -->
            <Frame parentKey="StatusBar" inherits="BackdropTemplate">
                <Size y="100"/>
                <Anchors>
                    <Anchor point="BOTTOMLEFT" relativeKey="$parent.BottomBar" relativePoint="TOPLEFT" x="0" y="0"/>
                    <Anchor point="BOTTOMRIGHT" relativeKey="$parent.BottomBar" relativePoint="TOPRIGHT" x="0" y="0"/>
                </Anchors>
                <Frames>
                    <!-- Read-only output box; no ScrollFrame around it, so it
                         shows whatever fits its current height. Same treatment
                         as the gutter's Numbers box: mouse and keyboard off so
                         it never takes focus or shows a caret. Font,
                         justification and insets come from Lua
                         (OnLoad_StatusBar, ApplyCodeFont); it is anchored in
                         OnLoad_Viewports alongside the other viewports. -->
                    <EditBox parentKey="EvalStatus" multiLine="true"
                             enableMouseClicks="false"
                             autoFocus="false" enableMouse="false" enableKeyboard="false"/>
                </Frames>
            </Frame>

            <!-- Drag handle between the code area and the output panel. It
                 resizes StatusBar; the code area follows because GutterBackdrop
                 and CodeBackdrop anchor their bottoms to this frame's top. -->
            <Button parentKey="StatusDivider" enableMouse="true">
                <Size y="10"/>
                <Anchors>
                    <Anchor point="BOTTOMLEFT" relativeKey="$parent.StatusBar" relativePoint="TOPLEFT" x="0" y="0"/>
                    <Anchor point="BOTTOMRIGHT" relativeKey="$parent.StatusBar" relativePoint="TOPRIGHT" x="0" y="0"/>
                </Anchors>
                <Layers>
                    <Layer level="ARTWORK">
                        <!-- Colored in Lua (ApplyTheme), like every other border here. -->
                        <Texture parentKey="Grip">
                            <Size x="80" y="4"/>
                            <Anchors>
                                <Anchor point="CENTER"/>
                            </Anchors>
                        </Texture>
                    </Layer>
                </Layers>
                <Scripts>
                    <OnMouseDown>
                        if button == "LeftButton" then
                        self:GetParent():OnStatusDividerMouseDown()
                        end
                    </OnMouseDown>
                    <OnMouseUp>
                        self:GetParent():OnStatusDividerMouseUp()
                    </OnMouseUp>
                    <OnEnter>
                        self:GetParent():OnStatusDividerHover(true)
                    </OnEnter>
                    <OnLeave>
                        self:GetParent():OnStatusDividerHover(false)
                    </OnLeave>
                </Scripts>
            </Button>

            <!-- Hidden measuring string for wrap mode: same font and wrap settings as
                 CodeEditBox, width matched to its text area, so GetNumLines() reports
                 how many visual rows a given logical line will occupy. -->
            <Frame parentKey="WrapMeasure" hidden="true">
                <Size x="1" y="1"/>
                <Layers>
                    <Layer level="ARTWORK">
                        <FontString parentKey="Text" inherits="LDK_CodeEditorFont"
                                    justifyH="LEFT" justifyV="TOP" wordwrap="true">
                            <Anchors>
                                <Anchor point="TOPLEFT"/>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>

            <!-- Borders live on separate backing frames: a ScrollFrame clips at its
                 outer rect, but a backdrop edge is drawn *inside* that rect, so
                 content scrolled under the border band. Gutter and code must keep
                 the same top inset or their line rows drift apart. -->
            <Frame parentKey="GutterBackdrop" inherits="BackdropTemplate">
                <Size x="34" y="1"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.TopBar" relativePoint="BOTTOMLEFT" x="16" y="0"/>
                    <Anchor point="BOTTOMLEFT" relativeKey="$parent.StatusDivider" relativePoint="TOPLEFT" x="16" y="0"/>
                </Anchors>
            </Frame>

            <!-- Gutter: line-number column, a real ScrollFrame so its content clips like
                 the code area does; vertical scroll is driven in lockstep with it (see
                 OnCodeEditBoxScroll) rather than by direct user interaction. -->
            <ScrollFrame parentKey="Gutter">
                <!-- Anchored in Lua (OnLoad_Viewports): its inset must track the code viewport's. -->
                <ScrollChild>
                    <!-- Size is set from Lua (RefreshGutter): scroll children keep their
                         explicit size over right-side anchors, so a fixed width here
                         would not follow the Gutter's inset width. -->
                    <Frame parentKey="ScrollChild">
                        <Size x="1" y="1"/>
                        <Anchors>
                            <!-- One corner only. RefreshGutter gives this frame its
                                 width and height; a second anchor would fight that. -->
                            <Anchor point="TOPLEFT"/>
                        </Anchors>
                        <Frames>
                            <!-- Read-only EditBox holding "1\n2\n...\nN" in the SAME font as
                                 CodeEditBox, so both columns get identical line pitch from
                                 the text engine: no per-line positioning math. Not a
                                 FontString: those truncate past ~30,000 characters or
                                 ~65,536 rendered height, which a long file reaches.
                                 Mouse and keyboard are off so it never takes focus or shows
                                 a caret. Font, justification and text insets are all set in
                                 Lua (OnLoad and ApplyCodeFont), so there is no nested
                                 FontString here; CodeEditBox has none either. The numbers
                                 are padded to a common digit width and LEFT justified, which
                                 is what lines the column up. See GutterDigits. -->
                            <EditBox parentKey="Numbers" multiLine="true"
                                     enableMouseClicks="false"
                                     autoFocus="false" enableMouse="false" enableKeyboard="false">
                                <Anchors>
                                    <Anchor point="TOPLEFT"/>
                                    <Anchor point="BOTTOMRIGHT"/>
                                </Anchors>
                            </EditBox>
                        </Frames>
                    </Frame>
                </ScrollChild>
            </ScrollFrame>

            <Frame parentKey="CodeBackdrop" inherits="BackdropTemplate">
                <Anchors>
                    <!-- x="-1" overlaps the gutter's border; a gap would show two borders. -->
                    <Anchor point="TOPLEFT" relativeKey="$parent.GutterBackdrop" relativePoint="TOPRIGHT" x="-1" y="0"/>
                    <Anchor point="BOTTOMRIGHT" relativeKey="$parent.StatusDivider" relativePoint="TOPRIGHT" x="-29" y="0"/>
                </Anchors>
            </Frame>

            <!-- Gap between CodeBackdrop's right edge and the scrollbar: ScrollFrame
                 anchors to this instead of CodeBackdrop directly, so widening its
                 Size x here opens a real visible gap. -->
            <Frame parentKey="ScrollBarGap">
                <Size x="3"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.CodeBackdrop" relativePoint="TOPRIGHT" x="0" y="0"/>
                    <Anchor point="BOTTOMLEFT" relativeKey="$parent.CodeBackdrop" relativePoint="BOTTOMRIGHT" x="0" y="0"/>
                </Anchors>
            </Frame>

            <!-- Code area: no-wrap EditBox inside a scroll frame (vertical scrollbar via UIPanelScrollFrameTemplate) -->
            <ScrollFrame parentKey="ScrollFrame" inherits="UIPanelScrollFrameTemplate">
                <!-- Anchored in Lua (OnLoad_Viewports): its inset must track the gutter's. -->
                <Scripts>
                    <!-- Focus fallback, mirroring Blizzard's InputScrollFrame_OnMouseDown
                         on UIPanelInputScrollFrameTemplate. The ScrollFrame sits below
                         CodeEditBox (its ScrollChild, so a higher frame level), which
                         means clicks landing on the text still reach the EditBox and
                         position the caret natively; only clicks that miss it land
                         here and get focus forwarded. -->
                    <OnMouseDown>
                        self.CodeEditBox:SetFocus()
                    </OnMouseDown>
                    <OnLoad>
                        -- Chain, don't clobber: UIPanelScrollFrameCodeTemplate wires
                        -- OnVerticalScroll to ScrollFrame_OnVerticalScroll, which syncs
                        -- the scrollbar's value and its up/down button states. Replacing
                        -- it outright left the scrollbar desynced from the real scroll
                        -- offset (WowLua's own handler does this same sync by hand).
                        self:SetScript("OnVerticalScroll", function(sf, offset)
                            ScrollFrame_OnVerticalScroll(sf, offset)
                            self:GetParent():OnCodeEditBoxScroll(offset)
                        end)
                        -- viewport resize (SizerSE drag) moves wrap points in wrap mode
                        self:SetScript("OnSizeChanged", function(sf)
                            self:GetParent():OnCodeViewportSizeChanged()
                        end)
                    </OnLoad>
                </Scripts>
                <ScrollChild>
                    <!-- EditBox has its own font (SetFontObject/GetFont), set from Lua
                         OnLoad  no nested FontString element needed. -->
                    <EditBox parentKey="CodeEditBox" mixin="LDK_CodeEditBoxMixin"
                             frameBuffer="true" countInvisibleLetters="true" multiLine="true">
                        <Size x="4000" y="1"/>
                        <Anchors>
                            <Anchor point="TOPLEFT"/>
                            <Anchor point="TOPRIGHT"/>
                        </Anchors>
                        <Scripts>
                            <OnLoad method="OnLoad"/>
                            <OnEscapePressed method="OnEscapePressed"/>
                            <OnTextChanged method="OnTextChanged"/>
                            <OnCursorChanged method="OnCursorChanged"/>
                            <OnKeyDown method="OnKeyDown"/>
                            <!-- Deliberately NO OnSizeChanged here. RefreshGutter is
                                 the only thing that ever resizes this EditBox, so an
                                 OnSizeChanged handler would only ever react to our own
                                 writes and call RefreshGutter again; a pure feedback
                                 edge that looped every frame and kept the caret from
                                 rendering. Real refresh triggers are covered by
                                 OnTextChanged, the ScrollFrame's OnSizeChanged
                                 (OnCodeViewportSizeChanged), SetWrapText and
                                 ApplyCodeFont. -->
                        </Scripts>
                    </EditBox>
                </ScrollChild>
            </ScrollFrame>
        </Frames>
    </Frame>

    <Frame name="LDK_CodeEditorDialog" hidden="true" movable="true" enableMouse="true"
           parent="UIParent"
           inherits="BackdropTemplate, LDK_CodeEditorDialogTemplate">
    </Frame>
</Ui>